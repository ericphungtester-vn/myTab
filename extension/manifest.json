{
  "manifest_version": 3,
  "name": "myTab",
  "version": "1.0.0",
  "description": "Personal new tab with a customizable bookmark dashboard and FlashPaint, a built-in screenshot annotation tool",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "clipboardRead", "bookmarks", "tabGroups"]
}
