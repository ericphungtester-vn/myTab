{
  "manifest_version": 3,
  "name": "myTool",
  "version": "0.1.0",
  "description": "A small toolbox of personal utilities — Text (placeholder text generator + character counter) and File (generate a file of a target size)",
  "action": {
    "default_popup": "popup.html",
    "default_title": "myTool",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"]
}
