{
  "manifest_version": 3,
  "name": "myTool",
  "version": "1.0.0",
  "description": "Local dev/QA toolbox: placeholder text, test files, synthetic data (IDs, IBAN, cards) and utilities (JSON, JWT, regex, hashing).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "myTool",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"]
}
